<UserControl x:Class="BlueIPRouter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- Top Summary Cards -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <ui:Card Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PUBLIC IPv4" FontSize="11" FontWeight="SemiBold" Foreground="#88FFFFFF" />
                        <TextBlock Text="{Binding PublicIp}" FontSize="22" FontWeight="Bold" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding PublicLocation}" FontSize="12" Foreground="#BBFFFFFF" />
                        <TextBlock Text="{Binding PublicIsp}" FontSize="11" Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="5,0,5,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="DEFAULT EGRESS" FontSize="11" FontWeight="SemiBold" Foreground="#88FFFFFF" />
                        <TextBlock Text="{Binding InternetVia}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,4" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Foreground="#BBFFFFFF">
                            <Run Text="Gateway: " />
                            <Run Text="{Binding PrimaryGateway, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="10,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="RULE HEALTH &amp; PROTECTION" FontSize="11" FontWeight="SemiBold" Foreground="#88FFFFFF" />
                        <TextBlock FontSize="22" FontWeight="Bold" Margin="0,6,0,4">
                            <Run Text="{Binding HelperStatus.AppliedRoutes.Count, Mode=OneWay}" />
                            <Run Text=" live routes" FontSize="14" FontWeight="Normal" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#BBFFFFFF">
                            <Run Text="Draft rules: " />
                            <Run Text="{Binding DraftRules.Count, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Active Interfaces Summary -->
            <TextBlock Text="Active Network Interfaces" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10" />
            <ItemsControl ItemsSource="{Binding Interfaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#88FFFFFF" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrimaryIpv4, TargetNullValue='No IPv4'}" FontSize="13" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="LimeGreen"
                                           Text="UP" Visibility="{Binding IsUp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
