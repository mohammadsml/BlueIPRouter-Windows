<UserControl x:Class="BlueIPRouter.App.Views.RoutingTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Kernel Routing Table" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ui:TextBox x:Name="FilterBox" Width="260" HorizontalAlignment="Right" PlaceholderText="Filter destination, gateway or interface..." TextChanged="FilterBox_TextChanged" />
        </DockPanel>

        <ui:DataGrid ItemsSource="{Binding RoutingTable}" x:Name="RoutesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="65" />
                <DataGridTextColumn Header="Destination" Binding="{Binding DestinationLabel}" Width="200" />
                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="160" />
                <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="*" />
                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80" />
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="100" />
            </DataGrid.Columns>
        </ui:DataGrid>
    </DockPanel>
</UserControl>
